<Window x:Class="SecureChat.QrScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureChat 扫码登录"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111111">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Background="#222222" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                <Border x:Name="ScanFrame" Width="260" Height="260" BorderBrush="#07C160" BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#07C160" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                    </Border.Effect>
                </Border>
                <TextBlock x:Name="StatusText" Text="正在启动摄像头…"
                           Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="没有摄像头？" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ManualText" Width="280" Padding="6,4" VerticalContentAlignment="Center"
                     ToolTip="粘贴 securechat://login?token=…" />
            <Button x:Name="ManualOkBtn" Content="确认" Margin="8,0,0,0" Padding="14,4" Click="ManualOk_Click" />
        </StackPanel>
    </Grid>
</Window>
