<Window x:Class="SecureChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureChat"
        Width="960" Height="640"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#EDEDED">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MessageBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Background" Value="{StaticResource BubbleOther}" />
        </Style>
        <DataTemplate x:Key="MessageTemplate">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding SenderName}" Foreground="#888888" FontSize="11" Margin="14,0,14,2"
                           Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}" />
                <Border Style="{StaticResource MessageBubble}"
                        HorizontalAlignment="{Binding Align}"
                        Background="{Binding BubbleBg}">
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding Align}" Margin="14,0">
                    <TextBlock Text="{Binding TimeText}" Foreground="#AAAAAA" FontSize="10" Margin="4,0,0,0" />
                    <TextBlock Text="·已读" Foreground="#07C160" FontSize="10" Margin="6,0,0,0"
                               Visibility="{Binding ReadBadgeVisibility}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ConversationTemplate">
            <Border x:Name="ConvRoot" Padding="10,8" Background="Transparent" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="20">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="11" Height="11" Fill="#07C160" Stroke="White" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Online}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            <Border Background="#E5E7EB" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                <TextBlock Text="群" FontSize="9" Foreground="#6B7280">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding LastPreview}" Foreground="#9CA3AF" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" MaxWidth="300" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding TimeText}" Foreground="#B0B0B0" FontSize="10" HorizontalAlignment="Right" />
                        <Border Background="#FA5151" CornerRadius="9" MinWidth="18" Height="18"
                                Margin="0,6,0,0" HorizontalAlignment="Right" Padding="4,0"
                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="#E5E7EB" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：会话列表 -->
        <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2E2E2E" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SecureChat" Foreground="White" FontSize="15" FontWeight="Bold" />
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#FACC15" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AddFriendBtn" Grid.Column="1" Content="＋" Width="30" Height="30" Margin="0,0,6,0"
                                ToolTip="添加好友" FontSize="18" Background="Transparent" Foreground="White" BorderThickness="0"
                                Click="AddFriend_Click" />
                        <Button x:Name="RequestsBtn" Grid.Column="2" Content="好友请求" Width="30" Height="30" Margin="0,0,6,0"
                                ToolTip="好友请求" FontSize="10" Background="#3A3A3A" Foreground="White" BorderThickness="0"
                                Click="Requests_Click" />
                        <Button x:Name="SettingsBtn" Grid.Column="3" Content="⚙" Width="30" Height="30"
                                ToolTip="设置" FontSize="14" Background="Transparent" Foreground="White" BorderThickness="0"
                                Click="Settings_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#F0F0F0" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#07C160" VerticalAlignment="Center">
                            <TextBlock x:Name="MyInitial" Text="S" Foreground="White" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MyName" Text="…" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="MyUid" Text="" FontSize="10" Foreground="#9CA3AF" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="会话" FontSize="11" Foreground="#9CA3AF" Margin="14,10,0,4" />

                <ListBox x:Name="ConvList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource ConversationTemplate}"
                         SelectionChanged="ConvList_SelectionChanged" />

                <TextBlock Grid.Row="4" x:Name="ConnStatus" Text="连接中…" Foreground="#9CA3AF" FontSize="10"
                           Padding="14,8" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 右侧：聊天区 -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChatTitle" Text="选择一个会话开始聊天" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChatSubtitle" Text="" Foreground="#9CA3AF" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="MsgScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MsgList" ItemTemplate="{StaticResource MessageTemplate}" Margin="0,8" />
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F0F0F0" Padding="10,8">
                <TextBlock x:Name="TypingHint" Text="" Foreground="#07C160" FontSize="12" MinHeight="16" />
            </Border>

            <Border Grid.Row="3" Background="#F7F7F7" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="14" Padding="8,6"
                             VerticalContentAlignment="Top" KeyDown="InputBox_KeyDown" />
                    <Button x:Name="SendBtn" Grid.Column="1" Content="发送" Width="72" Height="80"
                            Background="#07C160" Foreground="White" BorderThickness="0" FontSize="14"
                            FontWeight="SemiBold" Margin="8,0,0,0" Click="Send_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
